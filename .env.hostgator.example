# ==============================================================================
# RazelFood — modelo de .env para produção em hospedagem compartilhada HostGator
# ==============================================================================
# Copie para `.env` no servidor (fora do controle de versão) e preencha os
# valores marcados com <...>. Depois:
#   php artisan key:generate --force
#   php artisan migrate --force
#   php artisan db:seed --force
#   php artisan shield:generate --panel=tenant --all --no-interaction
#   php artisan storage:link
#   php artisan config:cache && php artisan route:cache && php artisan view:cache && php artisan event:cache
#   php artisan filament:optimize
#
# Pré-requisitos de infra:
#   - PHP 8.4 no MultiPHP Manager (o composer.lock tem Symfony 8.x, que exige >= 8.4.1)
#   - Um subdomínio real por tenant no cPanel + AutoSSL individual (sem curinga)
#   - Checkout da branch `producao` em ~/repositories/razelfood; Document Root
#     do domínio (e de cada subdomínio) apontando para .../repositories/razelfood/public
#   - Acesso SSH/Terminal e Cron Jobs no cPanel
# Runbook completo: ver reference_deploy_hostgator (memória) / artefato de deploy.
# ------------------------------------------------------------------------------

APP_NAME=RazelFood
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://razelfood.com.br

TIMEZONE=America/Sao_Paulo

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ------------------------------------------------------------------------------
# Multi-tenant (subdomínio por slug: {slug}.razelfood.com.br)
# ------------------------------------------------------------------------------
TENANCY_BASE_DOMAIN=razelfood.com.br
# Cache de resolução de tenant por slug — LIGADO em produção.
TENANCY_CACHE_ENABLED=true

# ------------------------------------------------------------------------------
# Logs — no compartilhado, use rotação diária e nível baixo
# ------------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ------------------------------------------------------------------------------
# Banco de dados — MySQL do cPanel
# O cPanel prefixa o nome do banco e do usuário com o nome da conta
# (ex.: cpaneluser_razelfood / cpaneluser_razel). Host quase sempre 127.0.0.1.
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=<conta>_razelfood
DB_USERNAME=<conta>_razel
DB_PASSWORD=<senha-do-banco>

# ------------------------------------------------------------------------------
# Sessão — driver database. SESSION_DOMAIN=null (não setar): cada subdomínio
# tem cookie próprio. Compartilhar (`.razelfood.com.br`) faz o login do painel
# central vazar para os subdomínios de tenant e cair em 403 no canAccessPanel
# (super admin tem tenant_id null). Não há fluxo de auth entre subdomínios.
# ------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# ------------------------------------------------------------------------------
# Cache / Fila — sem Redis/Memcached no plano compartilhado, tudo no banco.
# A fila é usada pela sincronização de localidades (IBGE/CEP) no painel central.
# Configure DOIS cron jobs no cPanel (PHP CLI 8.4, ex.: /opt/cpanel/ea-php84/root/usr/bin/php):
#   * * * * *  /opt/cpanel/ea-php84/root/usr/bin/php /home/<conta>/repositories/razelfood/artisan schedule:run >> /dev/null 2>&1
#   * * * * *  /opt/cpanel/ea-php84/root/usr/bin/php /home/<conta>/repositories/razelfood/artisan queue:work --stop-when-empty --max-time=50 >> /dev/null 2>&1
# ------------------------------------------------------------------------------
CACHE_STORE=database
# CACHE_PREFIX=razelfood
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=600

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ------------------------------------------------------------------------------
# E-mail — SMTP da hospedagem (crie a caixa no cPanel > Contas de E-mail).
# Porta 465 = SSL, porta 587 = TLS. Usuário é o endereço completo.
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mail.razelfood.com.br
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=nao-responder@razelfood.com.br
MAIL_PASSWORD=<senha-da-caixa>
MAIL_FROM_ADDRESS="nao-responder@razelfood.com.br"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# Sincronização de localidades (IBGE + varredura de CEP). Valores mais
# conservadores que o dev para não estourar limites de CPU/tempo do plano.
# ------------------------------------------------------------------------------
IBGE_BASE_URL=https://servicodados.ibge.gov.br/api/v1/localidades
LOCATION_SYNC_CHUNK_SIZE=40
LOCATION_SYNC_CONCURRENCY=5
LOCATION_SYNC_REQUEST_DELAY_MS=200
LOCATION_SYNC_MAX_ATTEMPTS_PER_CEP=3
LOCATION_SYNC_RETRY_BACKOFF_MS=500

# ------------------------------------------------------------------------------
# Frontend
# ------------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# reCAPTCHA v3: as chaves (site key + secret) são cadastradas POR TENANT no
# painel central, não aqui.
# ------------------------------------------------------------------------------
