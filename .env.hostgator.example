# ==============================================================================
# RazelFood — modelo de .env para produção em hospedagem compartilhada HostGator
# ==============================================================================
# Copie para `.env` no servidor (fora do controle de versão) e preencha os
# valores marcados com <...>. Depois:
#   php artisan key:generate
#   php artisan migrate --force
#   php artisan storage:link
#   php artisan config:cache && php artisan route:cache && php artisan view:cache
#   php artisan filament:optimize
#
# Pré-requisitos de infra a validar ANTES de assumir este ambiente:
#   - SSL wildcard para *.razelfood.com.br (subdomínio por tenant)
#   - Subdomínio curinga (*) apontando para a mesma pasta pública do app
#   - Acesso SSH (para os comandos artisan acima) e cron no cPanel
# ------------------------------------------------------------------------------

APP_NAME=RazelFood
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://razelfood.com.br

TIMEZONE=America/Sao_Paulo

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ------------------------------------------------------------------------------
# Multi-tenant (subdomínio por slug: {slug}.razelfood.com.br)
# ------------------------------------------------------------------------------
TENANCY_BASE_DOMAIN=razelfood.com.br
# Cache de resolução de tenant por slug — LIGADO em produção.
TENANCY_CACHE_ENABLED=true
TENANCY_CACHE_TTL_MINUTES=5

# ------------------------------------------------------------------------------
# Logs — no compartilhado, use rotação diária e nível baixo
# ------------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ------------------------------------------------------------------------------
# Banco de dados — MySQL do cPanel
# O cPanel prefixa o nome do banco e do usuário com o nome da conta
# (ex.: cpaneluser_razelfood / cpaneluser_razel). Host quase sempre 127.0.0.1.
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=<conta>_razelfood
DB_USERNAME=<conta>_razel
DB_PASSWORD=<senha-do-banco>

# ------------------------------------------------------------------------------
# Sessão — driver database; cookie compartilhado entre todos os subdomínios
# de tenant e o painel central (o ponto na frente é intencional).
# ------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.razelfood.com.br
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# ------------------------------------------------------------------------------
# Cache / Fila — sem Redis/Memcached no plano compartilhado, tudo no banco.
# A fila é usada pela sincronização de localidades (IBGE/CEP) no painel central.
# Configure DOIS cron jobs no cPanel (PHP CLI do plano, ex.: /usr/local/bin/php):
#   * * * * *  cd /home/<conta>/razelfood && php artisan schedule:run >> /dev/null 2>&1
#   * * * * *  cd /home/<conta>/razelfood && php artisan queue:work --stop-when-empty --max-time=50 >> /dev/null 2>&1
# ------------------------------------------------------------------------------
CACHE_STORE=database
# CACHE_PREFIX=razelfood
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=600

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ------------------------------------------------------------------------------
# E-mail — SMTP da hospedagem (crie a caixa no cPanel > Contas de E-mail).
# Porta 465 = SSL, porta 587 = TLS. Usuário é o endereço completo.
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mail.razelfood.com.br
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=nao-responder@razelfood.com.br
MAIL_PASSWORD=<senha-da-caixa>
MAIL_FROM_ADDRESS="nao-responder@razelfood.com.br"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# Sincronização de localidades (IBGE + varredura de CEP). Valores mais
# conservadores que o dev para não estourar limites de CPU/tempo do plano.
# ------------------------------------------------------------------------------
IBGE_BASE_URL=https://servicodados.ibge.gov.br/api/v1/localidades
LOCATION_SYNC_CHUNK_SIZE=40
LOCATION_SYNC_CONCURRENCY=5
LOCATION_SYNC_REQUEST_DELAY_MS=200
LOCATION_SYNC_MAX_ATTEMPTS_PER_CEP=3
LOCATION_SYNC_RETRY_BACKOFF_MS=500

# ------------------------------------------------------------------------------
# Frontend
# ------------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# reCAPTCHA v3: as chaves (site key + secret) são cadastradas POR TENANT no
# painel central, não aqui.
# ------------------------------------------------------------------------------
